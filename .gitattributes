*.sh        text eol=lf
*.py        text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.desktop   text eol=lf
*.template  text eol=lf
*.svg       text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
